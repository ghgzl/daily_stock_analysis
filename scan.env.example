# =============================================
# 本机三买扫描邮件配置（复制本文件为 scan.env 后填写）
# 云端(GitHub Actions)不需要此文件，用仓库 Secrets 自动注入
# =============================================

# 发件邮箱（需开启 SMTP 授权码，QQ邮箱在 设置->账号->POP3/IMAP/SMTP 开启并生成授权码）
EMAIL_SENDER=你的QQ号@qq.com
EMAIL_PASSWORD=你的SMTP授权码（不是QQ密码）
# 收件邮箱，多个用英文逗号分隔
EMAIL_RECEIVERS=接收邮箱@qq.com
# 发件人显示名称（可留空）
EMAIL_SENDER_NAME=股票分析助手

# ---- 扫描参数（可选，不填用默认） ----
# 股票池：all_a=全部A股(约5400只，默认，本机约1-2小时) / cs500=中证500 / hs300=沪深300 / custom:000725,600519
#SCAN_UNIVERSE=all_a
# 数据源：akshare=东财/新浪优先（国内本机默认，快） / auto=yahoo优先（海外服务器用）
#CHAN_DATA_SOURCE=akshare
# 数据起始日（默认 2004-01-01，数据太少三买不可靠）
#SCAN_START=2004-01-01
# 并发线程数（默认8；电脑好可调16更快，网络差调4更稳）
#SCAN_WORKERS=8
# 断点续跑：1=跳过上次已扫描的股票（默认）；0=每次全量重扫
#SCAN_RESUME=1
# 调试：只跑前 N 只（0=全部）
#SCAN_LIMIT=0
